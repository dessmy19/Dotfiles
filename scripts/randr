#!/bin/bash

RANDR_OUT="$(wlr-randr)"

outputs=$(printf '%s\n' "$RANDR_OUT" | awk '/^[^[:space:]]/{print $1}')
if [ -z "$outputs" ]; then
  notify-send -a randr -u critical 'Display' 'No outputs found'
  exit 1
fi

output=$(printf '%s\n' "$outputs" | wmenu "$@" -l 10 -p "Display>")
[ -z "$output" ] && exit 0

block=$(printf '%s\n' "$RANDR_OUT" | awk -v o="$output" '
  $0 ~ "^" o "[[:space:]]" { inside=1; next }
  inside && /^[^[:space:]]/ { exit }
  inside { print }
')

modes=$(printf '%s\n' "$block" | awk '
  /px,/ {
    line=$0
    sub(/^[[:space:]]*/, "", line)
    res=line; sub(/ px,.*/, "", res)
    rate=line; sub(/^.*px,[[:space:]]*/, "", rate); sub(/[[:space:]]*Hz.*/, "", rate)
    tag=""
    if (line ~ /current/) tag=" (current)"
    else if (line ~ /preferred/) tag=" (preferred)"
    printf "%s@%sHz%s\n", res, rate, tag
  }
')
if [ -z "$modes" ]; then
  notify-send -a randr -u critical 'Display' "No modes found for $output"
  exit 1
fi

mode_choice=$(printf '%s\n' "$modes" | wmenu "$@" -l 15 -p "Mode>")
[ -z "$mode_choice" ] && exit 0

mode=$(printf '%s\n' "$mode_choice" | sed -E 's/ \((current|preferred)\)$//')

sync_choice=$(printf 'On\nOff\n' | wmenu "$@" -l 2 -p "Adaptive Sync>")
[ -z "$sync_choice" ] && exit 0

case "$sync_choice" in
  On) sync=enabled ;;
  Off) sync=disabled ;;
  *) exit 0 ;;
esac

wlr-randr --output "$output" --mode "$mode" --adaptive-sync "$sync"

mkdir -p "$HOME/.cache"
printf -- "--output %s --mode %s --adaptive-sync %s\n" "$output" "$mode" "$sync" \
  >"$HOME/.cache/wlr-randr"

notify-send -a randr 'Display' "$output set to $mode, adaptive sync $sync"
