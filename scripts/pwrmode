#!/bin/bash

notify_power() {
  notify-send -a pwrmode 'Power Mode' "$1"
}

apply_power_mode() {
  mode="$1"

  case "$mode" in
    Powersave)   sudo -n powerctl apply powersave   || return 1 ;;
    Balanced)    sudo -n powerctl apply balanced    || return 1 ;;
    Performance) sudo -n powerctl apply performance || return 1 ;;
  esac

  notify_power "$mode applied"
}

raw_current=$(powerctl query 2>/dev/null) || raw_current="unknown"
case "$raw_current" in
  powersave)   current="Powersave" ;;
  balanced)    current="Balanced" ;;
  performance) current="Performance" ;;
  *)           current="Unknown" ;;
esac

chosen=$(printf 'Performance\nBalanced\nPowersave\n' | wmenu "$@" -l 3 -p "Power Mode (current: ${current})>")
[ -z "$chosen" ] && exit 0

apply_power_mode "$chosen" || {
  notify-send -a pwrmode -u critical 'Power Mode' "Failed to apply $chosen"
  exit 1
}
